{
  "name": "@pauloricca/spagbol",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:local": "node scripts/pack.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@xyflow/react": "12.11.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3"
  },
  "description": "Spagbol graph model, editing operations and extensible React canvas.",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./controls.css": "./dist/controls.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@xyflow/react": "^12.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "license": "UNLICENSED"
}
